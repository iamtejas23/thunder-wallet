# Copy to android/keystore.properties and fill in values.
# Generate a release keystore (SHA-256 signature):
#
#   keytool -genkeypair -v \
#     -storetype PKCS12 \
#     -keystore thunder-wallet-release.keystore \
#     -alias thunder-wallet \
#     -keyalg RSA -keysize 2048 \
#     -sigalg SHA256withRSA \
#     -validity 10000
#
# NEVER commit keystore files or this filled-in properties file.

storeFile=../thunder-wallet-release.keystore
storePassword=REPLACE_ME
keyAlias=thunder-wallet
keyPassword=REPLACE_ME
