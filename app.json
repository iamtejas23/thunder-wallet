{
  "expo": {
    "name": "Thunder Wallet",
    "slug": "thunder-wallet",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "thunderwallet",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tejas8787.thunderwallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock Thunder Wallet",
        "NSCameraUsageDescription": "Used for biometric authentication"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.tejas8787.thunderwallet",
      "versionCode": 3,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A0E1A",
          "sounds": []
        }
      ],
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Thunder Wallet accesses your photos to attach receipts to transactions.",
          "cameraPermission": "Thunder Wallet uses the camera to photograph receipts."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "20973568-e0e6-48b1-a5ee-2c55cd8b6f39"
      }
    }
  }
}
